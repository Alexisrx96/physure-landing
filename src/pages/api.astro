  <!-- Q_ -->
  <h2 id="q-factory">Q_ — Quantity Factory</h2>
  <div class="api-card">
    <div class="api-signature"><span class="api-name">Q_</span><span class="api-args">(value, unit, uncertainty=None)</span></div>
    <p>The primary entry point. Creates a <code>Quantity</code> from a value and unit string.</p>
    <h4>Parameters</h4>
    <table>
      <thead><tr><th>Parameter</th><th>Type</th><th>Description</th></tr></thead>
      <tbody>
        <tr>
          <td><code>value</code></td>
          <td><code>float | int | ndarray | Tensor | Array | str</code></td>
          <td>The numeric value. Accepts scalars, array-like (NumPy, PyTorch, JAX), or a string like <code>"10 m/s"</code>.</td>
        </tr>
        <tr>
          <td><code>unit</code></td>
          <td><code>str | CompoundUnit | None</code></td>
          <td>Unit expression. Required if value is not a string. Supports <code>/</code>, <code>*</code>, <code>^</code>, SI prefixes, and named units.</td>
        </tr>
        <tr>
          <td><code>uncertainty</code></td>
          <td><code>float</code></td>
          <td>Optional 1&sigma; standard deviation. Defaults to <code>0.0</code> (no uncertainty).</td>
        </tr>
        <tr>
          <td><code>symbol</code></td>
          <td><code>str | None</code></td>
          <td>Optional symbolic name for tracing (advanced use).</td>
        </tr>
      </tbody>
    </table>
    <h4>Returns</h4>
    <p><code>Quantity</code> — a unit-aware wrapper around the value.</p>
    <h4>Example</h4>
    <pre><code>from physure import Q_

# Scalar
v = Q_(10, "m/s")

# With uncertainty
g = Q_(9.81, "m/s^2", uncertainty=0.02)

# NumPy array
import numpy as np
arr = Q_(np.array([1, 2, 3]), "km")

# PyTorch tensor
import torch
t = Q_(torch.tensor([1.0, 2.0]), "kg")</code></pre>
  </div>

  <!-- Quantity -->
  <h2 id="quantity">Quantity</h2>
  <div class="api-card">
    <div class="api-signature"><span class="api-kw">class</span> <span class="api-name">Quantity</span></div>
    <p>Core class representing a physical quantity. Instances are typically created via <code>Q_()</code>.</p>

    <h4>Properties</h4>
    <table>
      <thead><tr><th>Property</th><th>Type</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.magnitude</code></td><td><code>float | ndarray | ...</code></td><td>The raw numeric value. This is the primary way to access the number.</td></tr>
        <tr><td><code>.m</code></td><td><code>float | ndarray | ...</code></td><td>Shorthand alias for <code>.magnitude</code> (pint-compatible).</td></tr>
        <tr><td><code>.unit</code></td><td><code>CompoundUnit</code></td><td>The attached physical unit.</td></tr>
        <tr><td><code>.u</code></td><td><code>CompoundUnit</code></td><td>Alias for <code>.unit</code>.</td></tr>
        <tr><td><code>.uncertainty</code></td><td><code>float | Numeric</code></td><td>Standard deviation (1&sigma;), returns <code>0.0</code> if none set.</td></tr>
        <tr><td><code>.dimension</code></td><td><code>Dimension</code></td><td>Dimensional signature (e.g. [length&sup2;]).</td></tr>
        <tr><td><code>.symbol</code></td><td><code>str | None</code></td><td>Optional symbolic name for tracing.</td></tr>
      </tbody>
    </table>

    <h4>Methods</h4>
    <table>
      <thead><tr><th>Method</th><th>Returns</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.to(unit_str)</code></td><td><code>Quantity</code></td><td>Returns a new Quantity converted to the given unit string. Raises <code>IncompatibleUnitsError</code> if units are incompatible.</td></tr>
        <tr><td><code>.to_base()</code></td><td><code>Quantity</code></td><td>Returns a new Quantity in SI base units (m, kg, s, A, K, mol, cd).</td></tr>
        <tr><td><code>.diff(var)</code></td><td><code>Quantity</code></td><td>Symbolic differentiation. Requires <code>[symbolic]</code> extra. <code>var</code> is a Quantity with symbolic magnitude.</td></tr>
        <tr><td><code>.__add__, __sub__</code></td><td><code>Quantity</code></td><td>Addition/subtraction. Raises <code>IncompatibleUnitsError</code> if units are incompatible.</td></tr>
        <tr><td><code>.__mul__, __truediv__</code></td><td><code>Quantity</code></td><td>Multiplication/division. Combines units automatically.</td></tr>
        <tr><td><code>.__pow__(n)</code></td><td><code>Quantity</code></td><td>Power. <code>Q_(2, "m") ** 3</code> → <code>8 m³</code>.</td></tr>
        <tr><td><code>.dot(other)</code></td><td><code>Quantity</code></td><td>Computes dot product for vector quantities.</td></tr>
        <tr><td><code>.cross(other)</code></td><td><code>Quantity</code></td><td>Computes cross product for vector quantities.</td></tr>
      </tbody>
    </table>

    <h4>Class methods</h4>
    <table>
      <thead><tr><th>Method</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>Quantity.from_input(value, unit, ...)</code></td><td>Alternative constructor. Use when you need finer control over the system or backend.</td></tr>
      </tbody>
    </table>

    <h4>Example</h4>
    <pre><code>from physure import Q_

F = Q_(100, "N")
A = Q_(0.5, "m^2")
P = F / A

print(P)           # 200.0 Pa
print(P.to("kPa")) # 0.2 kPa
print(P.unit)      # Pa
print(P.dimension) # [mass·length⁻¹·time⁻²]
print(P.magnitude) # 200.0 (raw numeric value)</code></pre>
  </div>

  <!-- Uncertainty -->
  <h2 id="tensors">Vectors & matrices</h2>
  <p>
    <code>Quantity</code> (scalar), <code>QuantityVector</code> (order-1 tensor) and
    <code>QuantityMatrix</code> (order-2 tensor) are separate first-class types in Rust, PHS, Python
    and Java — the distinction is enforced, not inferred. Every operation propagates physical units.
  </p>
  <div class="api-card">
    <div class="api-signature"><span class="api-kw">class</span> <span class="api-name">QuantityVector</span>(components: list[Quantity])</div>
    <table>
      <thead><tr><th>Method</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.dot(other) → Quantity</code></td><td>Dot product.</td></tr>
        <tr><td><code>.cross(other) → QuantityVector</code></td><td>Cross product.</td></tr>
        <tr><td><code>.norm() → Quantity</code></td><td>Euclidean norm, with uncertainty propagated correctly for the repeated operand.</td></tr>
        <tr><td><code>.unit_vector() → QuantityVector</code></td><td>The same direction, normalised.</td></tr>
      </tbody>
    </table>
  </div>
  <div class="api-card">
    <div class="api-signature"><span class="api-kw">class</span> <span class="api-name">QuantityMatrix</span>(data: list[list[Quantity]])</div>
    <table>
      <thead><tr><th>Method</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.transpose() → QuantityMatrix</code></td><td>Transpose.</td></tr>
        <tr><td><code>.matmul(other) → QuantityMatrix</code></td><td>Matrix multiplication.</td></tr>
        <tr><td><code>.det() → Quantity</code></td><td>Determinant.</td></tr>
      </tbody>
    </table>
  </div>
  <pre><code>from physure import Q_, QuantityVector, QuantityMatrix

F = QuantityVector([Q_(3, "N"), Q_(4, "N"), Q_(0, "N")])
d = QuantityVector([Q_(1, "m"), Q_(0, "m"), Q_(0, "m")])

print(F.norm())     # 5.0 N
print(F.dot(d))     # 3.0 J
print(F.cross(d))   # QuantityVector([0 N·m, 0 N·m, -4 N·m])

M = QuantityMatrix([[Q_(1, "m"), Q_(2, "m")],
                    [Q_(3, "m"), Q_(4, "m")]])
print(M.det())      # -2.0 m^2</code></pre>

  <!-- Uncertainty -->
  <h2 id="uncertainty">Uncertainty</h2>
  <div class="api-card">
    <div class="api-signature"><span class="api-kw">class</span> <span class="api-name">Uncertainty</span></div>
    <p>Abstract base class for uncertainty models. In practice you pass a <code>float</code> as the <code>uncertainty</code> argument to <code>Q_</code> — physure automatically wraps it in the appropriate model based on the active propagation mode.</p>
    <table>
      <thead><tr><th>Property / Method</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.std_dev</code></td><td>The standard deviation (1&sigma;).</td></tr>
        <tr><td><code>.variance</code></td><td>Not always available directly — access via <code>VarianceModel.variance</code>.</td></tr>
        <tr><td><code>.vector_slice</code></td><td>Slice into the covariance matrix (for correlated/vectorized mode).</td></tr>
      </tbody>
    </table>
    <pre><code>from physure import Q_

# Pass a float directly — it is auto-wrapped internally
q = Q_(9.81, "m/s^2", uncertainty=0.02)
print(q.uncertainty)       # 0.02 (std dev)
print(q.uncertainty**2)    # ~0.0004 (variance manually)</code></pre>
  </div>

  <h3>Asymmetric uncertainties</h3>
  <p>
    A measurement quoted as <code>12.3 +0.5 -0.4 pb</code> is not two standard deviations — it is the
    shape of a distribution, and averaging the two halves throws away the part that is often the
    interesting one. physure maps the pair onto the first three moments of a dimidiated Gaussian in
    closed form.
  </p>
  <div class="api-card">
    <div class="api-signature"><span class="api-name">physure._core.MomentsBackend</span> · <span class="api-name">physure._core.AsymmetricMoments</span></div>
    <table>
      <thead><tr><th>Entry point</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>MomentsBackend.measured(value, sigma_minus, sigma_plus)</code></td><td>Builds a moments-backed value from a pair of half-widths.</td></tr>
        <tr><td><code>.moments() → AsymmetricMoments</code></td><td>Mean shift, variance, and third moment.</td></tr>
        <tr><td><code>max_skewness()</code></td><td>The largest skew a pair of half-widths can describe (just under 1, reached when one side is zero). Anything beyond it is reported, not rounded down.</td></tr>
      </tbody>
    </table>
  </div>
  <pre><code>import physure
from physure import Q_

# Choose the model per scope — carrying three moments across a large
# dataset costs more than carrying one standard deviation
with physure.uncertainty_model("moments"):
    xsec = Q_(12.3, "pb", uncertainty=(0.5, 0.4))</code></pre>
  <div class="callout callout-info">
    <p>
      <strong>Propagation is deliberately not implemented yet.</strong> Every arithmetic path on a
      moments value raises rather than falling through to a symmetric rule — which would report a
      plausible number with the skew quietly averaged away. This is the groundwork a propagation
      model can be built on, not the model itself.
    </p>
  </div>

  <!-- Module Functions -->
  <h2 id="module-functions">Module-level functions</h2>
  <p>These are all importable directly from <code>physure</code>:</p>
  <table>
    <thead><tr><th>Function</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td><code>get_current_system()</code></td><td>Returns the active UnitSystem.</td></tr>
      <tr><td><code>get_unit(expr)</code></td><td>Parses and returns a Unit object from an expression string.</td></tr>
      <tr><td><code>propagation_mode(mode)</code></td><td>Context manager to switch between uncertainty propagation modes: <code>"correlated"</code> (default), <code>"uncorrelated"</code>, <code>"monte_carlo"</code>, <code>"unscented"</code>.</td></tr>
      <tr><td><code>uncertainty_mode(mode)</code></td><td>Context manager for the uncertainty computation backend.</td></tr>
      <tr><td><code>uncertainty_model(model)</code></td><td>Context manager choosing the <em>shape</em> of the distribution a quantity is built with: <code>"gaussian"</code> (default) or <code>"moments"</code>. Distinct from <code>propagation_mode</code>, which handles correlations.</td></tr>
      <tr><td><code>get_propagation_mode()</code> / <code>get_uncertainty_model()</code></td><td>Read the mode and model currently in force.</td></tr>
      <tr><td><code>system_context(system)</code></td><td>Context manager to use a custom UnitSystem (aliased as <code>use_system</code> internally).</td></tr>
      <tr><td><code>create_system(config)</code></td><td>Creates a UnitSystem from a config name (e.g. <code>"imperial.conf"</code>).</td></tr>
      <tr><td><code>create_default_system()</code></td><td>Creates and returns the default SI-based UnitSystem.</td></tr>
      <tr><td><code>save_state(path, quantities)</code></td><td>Serializes quantities to disk (requires <code>[io]</code> extra).</td></tr>
      <tr><td><code>load_state(path)</code></td><td>Deserializes quantities from disk (requires <code>[io]</code> extra).</td></tr>
      <tr><td><code>jit(fn)</code></td><td>Decorator/function to JIT-compile a unit-aware function.</td></tr>
    </tbody>
  </table>

  <h3>propagation_mode example</h3>
  <pre><code>import physure
from physure import Q_

# Default is 'correlated' — x - x = 0 exactly
x = Q_(5.0, "m", uncertainty=0.1)
delta = x - x
print(delta.uncertainty)   # ~0.0  (correlated cancellation)

# Switch to uncorrelated mode
with physure.propagation_mode("uncorrelated"):
    delta2 = x - x   # 0.0 ± 0.141 m  (errors add in quadrature)

# Other modes: "monte_carlo", "unscented"
with physure.propagation_mode("monte_carlo"):
    ...</code></pre>

  <!-- PHS API -->
  <h2 id="grammar-api">PHS API</h2>
  <p>
    <code>Interpreter</code> runs PHS — physure's DSL — through the same Rust engine as the
    standalone <a href="/cli"><code>phs</code></a> binary. Import it from <code>physure</code>:
  </p>
  <div class="api-card">
    <div class="api-signature"><span class="api-kw">class</span> <span class="api-name">Interpreter</span>(base_dir: str | None = None)</div>
    <p><code>base_dir</code> resolves <code>import</code> statements relative to that directory instead of the process's working directory.</p>
    <h4>Methods</h4>
    <table>
      <thead><tr><th>Method</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.evaluate(source: str) → list</code></td><td>Runs one or more statements and returns one result per statement.</td></tr>
        <tr><td><code>.register_function(fn, name: str)</code></td><td>Exposes a Python callable to PHS under <code>name</code>. Arguments arrive as Quantity, float, bool, str, None or list.</td></tr>
        <tr><td><code>.deriv(expr: str, var: str) → str</code></td><td>Symbolic derivative of <code>expr</code> with respect to <code>var</code>.</td></tr>
        <tr><td><code>.integral(expr: str, var: str) → str</code></td><td>Symbolic integral.</td></tr>
        <tr><td><code>.solve(equation: str, var: str) → str</code></td><td>Solves <code>equation</code> for <code>var</code>.</td></tr>
        <tr><td><code>.get_fn_params(name: str) → list | None</code></td><td>Parameter names of a PHS function, or None if it isn't defined.</td></tr>
        <tr><td><code>.reload_native_ext() → list</code></td><td>Re-scans <code>ext/</code> for changed plugins and returns the names reinstalled. No-op without <code>base_dir</code>.</td></tr>
      </tbody>
    </table>
    <h4>PHS syntax</h4>
    <table>
      <thead><tr><th>Syntax</th><th>Description</th></tr></thead>
      <tbody>
        {phsApi.map(g => (
          <tr>
            <td><code>{g.syntax}</code></td>
            <td>{g.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="callout callout-warning">
    <p><strong>Removed:</strong> <code>physure.ext.grammar</code> and its <code>GrammarInterpreter</code> — the Python reimplementation of the language — are gone. <code>Interpreter</code> replaces them and runs the same engine PHS and Rust use, so the three cannot drift apart. Replace <code>.run(...)</code> and <code>.eval(...)</code> with <code>.evaluate(...)</code>.</p>
  </div>

  <h3 id="phyfunction">PhyFunction & PhyEquation</h3>
  <p>
    A PHS function or equation, held as a Python object. Functions compose and do arithmetic like
    the math they represent, and equations stay solvable in either direction.
  </p>
  <div class="api-card">
    <div class="api-signature"><span class="api-kw">class</span> <span class="api-name">PhyFunction</span>(interpreter, name: str, body: str)</div>
    <table>
      <thead><tr><th>Method</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.get_params() → list[str]</code></td><td>Parameter names, in order.</td></tr>
        <tr><td><code>fn(*args) → Quantity</code></td><td>Call it with quantities; units are checked.</td></tr>
        <tr><td><code>.deriv(var)</code> / <code>.integral(var)</code></td><td>Symbolic derivative or integral, returned as another <code>PhyFunction</code>.</td></tr>
        <tr><td><code>.solve(var) → PhyFunction</code></td><td>Rearranges for <code>var</code>.</td></tr>
        <tr><td><code>f + g</code>, <code>f - g</code>, <code>f * g</code>, <code>f / g</code></td><td>Function algebra — superpose fields, combine transfer functions.</td></tr>
        <tr><td><code>.compose(other)</code></td><td>Builds <code>c(x) = f(g(x))</code>.</td></tr>
      </tbody>
    </table>
  </div>
  <div class="api-card">
    <div class="api-signature"><span class="api-kw">class</span> <span class="api-name">PhyEquation</span>(expression: str, interpreter=None)</div>
    <table>
      <thead><tr><th>Method</th><th>Description</th></tr></thead>
      <tbody>
        <tr><td><code>.solve(var) → PhyEquation</code></td><td>Solves for <code>var</code>, whichever side it sits on.</td></tr>
        <tr><td><code>eq(**kwargs) → Quantity</code></td><td>Substitutes the free symbols and evaluates.</td></tr>
        <tr><td><code>.lhs</code> / <code>.rhs</code></td><td>Either side, as a string.</td></tr>
        <tr><td><code>+ - * / **</code></td><td>Equation arithmetic, applied to both sides.</td></tr>
      </tbody>
    </table>
  </div>
  <pre><code>from physure import Q_, Interpreter, PhyFunction

interp = Interpreter()
ke = PhyFunction(interp, "kinetic_energy", "kinetic_energy(m, v) = 0.5 * m * v^2")

print(ke.get_params())                     # ['m', 'v']
print(ke(Q_(10, "kg"), Q_(5, "m/s")).to("J"))   # 125.0 J

# Symbolic derivative, still callable
dke_dv = ke.deriv("v")
print(dke_dv(Q_(10, "kg"), Q_(5, "m/s")))  # 50.0 kg·m/s</code></pre>

  <!-- Exceptions -->
  <h2 id="exceptions">Exceptions</h2>
  <table>
    <thead><tr><th>Exception</th><th>Raised when</th></tr></thead>
    <tbody>
      <tr><td><code>physureError</code></td><td>Base class for all physure exceptions.</td></tr>
      <tr><td><code>IncompatibleUnitsError</code></td><td>Arithmetic between incompatible dimensions (e.g. adding meters to seconds). This is the primary error for dimension mismatches.</td></tr>
      <tr><td><code>ConversionError</code></td><td>Attempting to convert between incompatible dimensions (e.g. meters to seconds).</td></tr>
      <tr><td><code>UnitNotFoundError</code></td><td>A unit string is not recognized by the system.</td></tr>
      <tr><td><code>UnknownUnitError</code></td><td>Unit expression could not be parsed; includes spelling suggestions.</td></tr>
      <tr><td><code>DimensionError</code></td><td>Invalid operation on dimensions (base class, may be raised in edge cases).</td></tr>
    </tbody>
  </table>
  <div class="callout callout-warning">
    <p><strong>Note:</strong> The error raised when adding incompatible units (e.g. <code>Q_(10, "m") + Q_(5, "s")</code>) is <code>IncompatibleUnitsError</code>, not <code>DimensionError</code>. Both are exported from <code>physure</code>.</p>
  </div>
  <pre><code>from physure import Q_, ConversionError, IncompatibleUnitsError

try:
    Q_(10, "m").to("s")   # length → time: invalid conversion
except ConversionError as e:
    print(f"Conversion error: &#123;e&#125;")

try:
    Q_(10, "m") + Q_(5, "s")  # incompatible add
except IncompatibleUnitsError as e:
    print(f"Incompatible units: &#123;e&#125;")</code></pre>

